# Copie para .env e preencha. O .env NUNCA vai para o GitHub.

# Postgres. No Supabase: Project Settings > Database > Connection string > "Session pooler"
# (o Render não acessa o endereço direto do Supabase, que é só IPv6)
DATABASE_URL=postgresql://postgres.SEU_PROJETO:SUA_SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
# true no Supabase/produção; false num Postgres local
DATABASE_SSL=true

# Segredo dos tokens de login. Gere um com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-isto

# Endereços do site que podem chamar a API, separados por vírgula
CORS_ORIGIN=http://localhost:5173

PORT=3001
